# =============================================================================
# Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# Backend API URL
# Development: http://localhost:4000
# Production: set to your deployed backend URL (e.g., Railway)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase Configuration (for client-side access)
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Google Forms Integration ────────────────────────────────────────────────
# Base viewform URL (strip any ?usp=... before pasting).
NEXT_PUBLIC_GOOGLE_FORM_URL=

# Pre-fill field entry IDs — found in the form's pre-fill URL after clicking
# "Get pre-filled link" in the form editor.
# Format: entry.XXXXXXXXX  (the number after "entry.")
#
# Field: which animal the applicant wants to adopt (animal database ID)
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_ANIMAL_ID=

# Field: animal name shown to staff for quick reference
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_ANIMAL_NAME=
