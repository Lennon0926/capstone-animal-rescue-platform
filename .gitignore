# macOS
.DS_Store

# GitHub Copilot skills
.github/*
!.github/workflows/
!.github/dependabot.yml

# Python local env/cache artifacts
venv/
.venv/
__pycache__/
*.pyc
*.py[cod]

# Node dependencies and generated frontend artifacts
node_modules/
apps/web/node_modules/
apps/server/node_modules/
.next/

# Local environment files (never commit real secrets)
.env
.env.*
apps/web/.env
apps/web/.env.*
apps/server/.env
apps/server/.env.*

# Keep env templates committed
!.env.example
!apps/web/.env.example
!apps/server/.env.example

# Cloudflare Wrangler local state
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Supabase local CLI/runtime artifacts
supabase/.temp/
supabase/.env
